  "item": [
    {
      "name": "0. Setup & Authentication",
      "description": "Register users, log them in, and capture JWT tokens and user IDs for subsequent requests.",
      "item": [
        {
          "name": "Register Customer User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"customer_user_id\", jsonData.id);",
                  "pm.environment.set(\"customer_username\", jsonData.username);",
                  "pm.environment.set(\"customer_jwt_token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"customer_user\",\n    \"password\": \"User@123\",\n    \"email\": \"customer@example.com\",\n    \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
