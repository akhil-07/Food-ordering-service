      "name": "6. Payment Management",
      "description": "APIs for customers to pay for orders and retrieve payment details.",
      "item": [
        {
          "name": "Pay for Order (as Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"orderId\": {{order_id}},\n    \"paymentMode\": \"CARD\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
